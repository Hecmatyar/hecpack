    { "id": "nest", "label": "NestJS", "kind": "backend", "detect": { "deps": ["@nestjs/core"] }, "covers": ["structure", "backend", "docs"], "search": ["nestjs", "nest"], "docs": "context7" },
    { "id": "zustand", "label": "Zustand", "kind": "state", "detect": { "deps": ["zustand"] }, "covers": ["docs"], "search": ["zustand"], "docs": "context7" },
    { "id": "jest", "label": "Jest", "kind": "test", "detect": { "deps": ["jest", "jest-expo"] }, "covers": ["validation"], "search": ["jest"], "docs": "context7" },
    { "id": "vitest", "label": "Vitest", "kind": "test", "detect": { "deps": ["vitest"] }, "covers": ["validation"], "search": ["vitest"], "docs": "context7" },
    { "id": "playwright", "label": "Playwright", "kind": "e2e", "detect": { "deps": ["@playwright/test", "playwright"], "files": ["playwright.config.ts", "playwright.config.js"] }, "covers": ["e2e"], "search": ["playwright"], "docs": "context7" },
    { "id": "cypress", "label": "Cypress", "kind": "e2e", "detect": { "deps": ["cypress"] }, "covers": ["e2e"], "search": ["cypress"], "docs": "context7" },
    { "id": "maestro", "label": "Maestro", "kind": "e2e", "detect": { "files": [".maestro", "maestro"] }, "covers": ["e2e"], "search": ["maestro"], "docs": "web" },
    { "id": "eslint", "label": "ESLint", "kind": "lint", "detect": { "deps": ["eslint"] }, "covers": ["validation"], "search": ["eslint"], "docs": "context7" },
    { "id": "biome", "label": "Biome", "kind": "lint", "detect": { "deps": ["@biomejs/biome"], "files": ["biome.json"] }, "covers": ["validation"], "search": ["biome"], "docs": "context7" },
    { "id": "docker", "label": "Docker", "kind": "infra", "detect": { "files": ["Dockerfile", "docker-compose.yml", "compose.yaml"] }, "covers": ["docs"], "search": ["docker"], "docs": "context7" }
