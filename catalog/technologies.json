    { "id": "turborepo", "label": "Turborepo", "kind": "monorepo", "detect": { "deps": ["turbo"], "files": ["turbo.json"] }, "covers": ["structure", "validation"], "search": ["turborepo", "turbo", "monorepo"], "docs": "context7" },
    { "id": "pnpm-workspaces", "label": "pnpm workspaces", "kind": "monorepo", "detect": { "files": ["pnpm-workspace.yaml"] }, "covers": ["structure"], "search": ["pnpm", "monorepo"], "docs": "context7" },
    { "id": "firebase", "label": "Firebase", "kind": "backend", "detect": { "deps": ["firebase", "firebase-admin", "@react-native-firebase/app"], "files": ["firebase.json"] }, "covers": ["backend", "docs"], "search": ["firebase", "firestore"], "docs": "context7" },
