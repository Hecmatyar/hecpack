{
  "$comment": "Technologies hecpack recognizes. detect: deps (any package.json in the workspace), files (paths or globs at the root or in a workspace), appJsonKey (a key in app.json). covers: the core's slots this technology fills or needs filled (validation, structure, platform, ui, e2e, backend, docs). search: words matched against plugin names and descriptions in the marketplaces known to Claude Code. docs: where the current docs for the installed version live.",
  "slots": {
    "validation": "Validation commands (typecheck, lint, tests)",
    "structure": "Project structure and its rules",
    "platform": "Platform rules (platform files, native code, builds)",
    "ui": "UI rules (components, design system, accessibility)",
    "e2e": "End-to-end tests and how to run them",
    "backend": "Data, backend and access rules",
    "docs": "Current docs for the installed versions"
  },
  "technologies": [
    { "id": "typescript", "label": "TypeScript", "kind": "language", "detect": { "deps": ["typescript"], "files": ["tsconfig.json"] }, "covers": ["validation", "docs"], "search": ["typescript"], "docs": "context7" },
    { "id": "javascript", "label": "JavaScript / Node", "kind": "language", "detect": { "files": ["package.json"] }, "covers": ["validation"], "search": ["node", "javascript"], "docs": "context7" },
    { "id": "python", "label": "Python", "kind": "language", "detect": { "files": ["pyproject.toml", "requirements.txt", "setup.py"] }, "covers": ["validation", "docs"], "search": ["python"], "docs": "context7" },
    { "id": "go", "label": "Go", "kind": "language", "detect": { "files": ["go.mod"] }, "covers": ["validation", "docs"], "search": ["go", "gopls"], "docs": "context7" },
    { "id": "rust", "label": "Rust", "kind": "language", "detect": { "files": ["Cargo.toml"] }, "covers": ["validation", "docs"], "search": ["rust", "rust-analyzer"], "docs": "context7" },
    { "id": "swift", "label": "Swift", "kind": "language", "detect": { "files": ["Package.swift", "*.xcodeproj", "ios/*.xcodeproj"] }, "covers": ["validation", "platform", "docs"], "search": ["swift", "xcode"], "docs": "context7" },
    { "id": "react", "label": "React", "kind": "framework", "detect": { "deps": ["react"] }, "covers": ["ui", "docs"], "search": ["react"], "docs": "context7" },
    { "id": "next", "label": "Next.js", "kind": "framework", "detect": { "deps": ["next"], "files": ["next.config.js", "next.config.mjs", "next.config.ts"] }, "covers": ["structure", "ui", "docs"], "search": ["next.js", "nextjs", "vercel"], "docs": "context7" },
    { "id": "vite", "label": "Vite", "kind": "build", "detect": { "deps": ["vite"], "files": ["vite.config.ts", "vite.config.js"] }, "covers": ["validation", "docs"], "search": ["vite"], "docs": "context7" },
    { "id": "vue", "label": "Vue", "kind": "framework", "detect": { "deps": ["vue"] }, "covers": ["ui", "docs"], "search": ["vue", "nuxt"], "docs": "context7" },
    { "id": "svelte", "label": "Svelte", "kind": "framework", "detect": { "deps": ["svelte"] }, "covers": ["ui", "docs"], "search": ["svelte", "sveltekit"], "docs": "context7" },
    { "id": "angular", "label": "Angular", "kind": "framework", "detect": { "deps": ["@angular/core"] }, "covers": ["structure", "ui", "docs"], "search": ["angular"], "docs": "context7" },
    { "id": "expo", "label": "Expo", "kind": "platform", "detect": { "deps": ["expo"], "appJsonKey": "expo" }, "covers": ["platform", "ui", "docs"], "search": ["expo"], "docs": "context7", "pack": "expo-ios-hig" },
    { "id": "react-native", "label": "React Native", "kind": "platform", "detect": { "deps": ["react-native"] }, "covers": ["platform", "ui", "docs"], "search": ["react native", "react-native"], "docs": "context7", "pack": "expo-ios-hig" },
    { "id": "tamagui", "label": "Tamagui", "kind": "ui", "detect": { "deps": ["tamagui", "@tamagui/core"] }, "covers": ["ui", "docs"], "search": ["tamagui"], "docs": "context7", "pack": "expo-ios-hig" },
